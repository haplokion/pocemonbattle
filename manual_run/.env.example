# =============================================================================
# Конфигурация окружения для ручного запуска «Покемон-баттл»
# Скопируйте этот файл в .env в корне проекта или оставьте значения по умолчанию
# =============================================================================

# Режим базы данных:
#   auto         - сначала пробует подключиться к Oracle DB, при недоступности переключается на встроенный SQLite
#   sqlite_only  - форсированно использовать локальный движок SQLite (не требует Oracle)
#   oracle_only  - строго требовать подключение к Oracle DB
DB_MODE=auto

# Настройки подключения к Oracle Database (если используется реальный сервер СУБД)
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=FREEPDB1
ORACLE_ADMIN_USER=SYSTEM
ORACLE_ADMIN_PASSWORD=OraclePassword#123

# Настройки сетевого сервера приложения
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
